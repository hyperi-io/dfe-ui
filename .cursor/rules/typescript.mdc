## Stream Processing

```typescript
// Transform stream
const doubled = Stream.fromIterable([1, 2, 3, 4, 5]).pipe(
  Stream.map((n) => n * 2),
  Stream.filter((n) => n > 4),
);

// Async with batching
queryStream.pipe(
  Stream.map((row) => row.json()),
  Stream.mapEffect((event) => processEvent(event)),
  Stream.grouped(100),
  Stream.mapEffect((batch) => saveBatch(batch)),
  Stream.runDrain,
