## HTTP Client (Effect Platform)

```typescript
// Basic
const fetchUser = (userId: string) =>
  pipe(
    HttpClientRequest.get(`/api/users/${userId}`),
    HttpClient.execute,
    Effect.andThen((response) => response.json),
    Effect.andThen(Schema.decodeUnknown(User)),
