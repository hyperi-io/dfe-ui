## Caching

```typescript
// TTL cache
const CachedJWTKeys = Effect.cachedWithTTL(
  fetchAndDecodeJWKS(), Duration.hours(24),
);

// Request deduplication with batching
const UserResolver = RequestResolver.makeBatched(
  (requests: GetUser[]) => Effect.gen(function* () {
    const users = yield* UserRepository.findByIds(requests.map((r) => r.id));
    return requests.map((req) => {
      const user = users.find((u) => u.id === req.id);
      return user ? Request.succeed(req, user) : Request.fail(req, new UserNotFoundError({ id: req.id }));
    });
  }),
);
```

