// With retry + timeout
pipe(
  HttpClientRequest.get(url),
  HttpClient.execute,
  Effect.retry(Schedule.exponential("100 millis").pipe(
    Schedule.compose(Schedule.recurs(3)), Schedule.jittered)),
  Effect.timeout("30 seconds"),
);

// Authenticated client layer
const AuthenticatedClient = Effect.gen(function* () {
  const baseClient = yield* HttpClient.HttpClient;
  const token = yield* Config.string("API_TOKEN");
  return baseClient.pipe(
    HttpClient.mapRequest(HttpClientRequest.setHeader("Authorization", `Bearer ${token}`)),
    HttpClient.filterStatusOk,
  );
});
```

