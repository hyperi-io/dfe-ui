# Authentication
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=secret # Required for JWT signing (e.g. `openssl rand -base64 32`)

# Auth mode: 'credentials' (default, local dev password flow) or 'proxy'.
# 'proxy' = single origin behind Envoy: trust the engine's forwarded ES384 JWT
# (dfe_token cookie / Bearer) after re-verifying it against the engine JWKS.
# DFE_AUTH_MODE=credentials
# NEXT_PUBLIC_DFE_AUTH_MODE=credentials # client-visible mirror (auto sign-in)
# DFE_ENGINE_JWKS_URL=http://localhost:8003/.well-known/jwks.json
# DFE_ENGINE_JWT_ISSUER=dfe-engine # optional; enforced when set

# API
NEXT_PUBLIC_API_URL=http://localhost:8003
# NEXT_PUBLIC_API_URL=http://localhost:4010 # Prism backend - Mock backend for dfe-engine
# INTERNAL_API_URL=http://dfe-engine:8003

# HyperDX
HYPERDX_PORT=8090

# DevAlerts
NEXT_PUBLIC_DEV_ALERTS=true

## Auth session / token refresh (milliseconds unless noted)
## Must be smaller than the access token expiration time
# NEXT_PUBLIC_ACCESS_TOKEN_REFRESH_BUFFER_MS=300000
## Minimum time between refresh API calls (avoids loops while session catches up).
# NEXT_PUBLIC_ACCESS_TOKEN_MIN_REFRESH_INTERVAL_MS=120000
## How often AuthSessionMonitor re-evaluates whether a refresh is needed.
# NEXT_PUBLIC_ACCESS_TOKEN_SESSION_CHECK_INTERVAL_MS=60000
## NextAuth SessionProvider poll interval (seconds)
## Interval (seconds) for auth store session + /auth/me refresh
## NOT for token refresh
## Mainly used for RBAC and user profile data
# NEXT_PUBLIC_SESSION_REFETCH_INTERVAL_SECONDS=300