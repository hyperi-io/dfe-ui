## ============================================================================
## Authentication
## ============================================================================
## NEXTAUTH_SECRET: Required for JWT signing (e.g. `openssl rand -base64 32`)

NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_SECRET=

## ============================================================================
## API
## ============================================================================
NEXT_PUBLIC_API_URL=http://localhost:8003

## ============================================================================
## HyperDX
## ============================================================================
## Both runtime, read by the (auth) layout. HYPERDX_URL wins when set (HyperDX
## on its own hostname); otherwise HYPERDX_PORT derives the base URL from
## window.location, same host, different port.

HYPERDX_PORT=8080
# HYPERDX_URL=https://hyperdx.example.com

## ============================================================================
## DevAlerts
## ============================================================================
NEXT_PUBLIC_DEV_ALERTS=true

## ============================================================================
## Acceptance-test admin login
## ============================================================================
## Read by the Playwright fixture (e2e/config/login.helpers.ts), never by the app.
## No default: put the password the deployment under test minted into .env.local.
## The suite fails with that message when it is unset.

# E2E_ADMIN_PASSWORD=

## ============================================================================
## OIDC acceptance-test logins
## ============================================================================
## Read by the Playwright fixture (e2e/config/login.helpers.ts), never by the app.
## Copy into .env.local and paste the pre-shared password -- no real value here.
## The password has no default, and a provider without one is skipped, not failed.
## Per-provider overrides win over the generic pair, with <PROVIDER> uppercased as
## /api/v1/auth/setup-status names it -- DEX, OKTA, ENTRA, GOOGLE:
##   DFE_OIDC_OKTA_FIXTURE_USER=
##   DFE_OIDC_OKTA_FIXTURE_PASSWORD=

DFE_OIDC_FIXTURE_USER=dfe-test@dfe-oidc.test
# DFE_OIDC_FIXTURE_PASSWORD=

## ============================================================================
## Auth Session / Token Refresh
## ============================================================================
## NEXT_PUBLIC_ACCESS_TOKEN_REFRESH_BUFFER_MS must be smaller than the access token expiration time
## NEXT_PUBLIC_ACCESS_TOKEN_MIN_REFRESH_INTERVAL_MS: minimum time between refresh API calls (avoids loops while session catches up).
## NEXT_PUBLIC_ACCESS_TOKEN_SESSION_CHECK_INTERVAL_MS: how often AuthSessionMonitor re-evaluates whether a refresh is needed.
## NEXT_PUBLIC_SESSION_REFETCH_INTERVAL_SECONDS: NextAuth SessionProvider poll interval (seconds) - not used for token refresh. Primarily used for RBAC and user profile data refreshes.

NEXT_PUBLIC_ACCESS_TOKEN_REFRESH_BUFFER_MS=300000
NEXT_PUBLIC_ACCESS_TOKEN_MIN_REFRESH_INTERVAL_MS=60000
NEXT_PUBLIC_ACCESS_TOKEN_SESSION_CHECK_INTERVAL_MS=60000
NEXT_PUBLIC_SESSION_REFETCH_INTERVAL_SECONDS=300

## ============================================================================
## Display Defaults - no code effect, just for display purposes
## ============================================================================
NEXT_PUBLIC_YAML_POSTFIX=.yml