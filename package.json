{
  "name": "dfe-ui",
  "private": true,
  "description": "Web console for the HyperI Data Fusion Engine. Talks only to the dfe-engine API, with HyperDX embedded for data exploration.",
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "audit": "node scripts/audit.mjs",
    "build": "turbo run build",
    "start": "yarn workspace dfe-core-ui start",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{css,json,md,mjs,ts,tsx,yaml,yml}\"",
    "format:check": "prettier --check .",
    "check-types": "turbo run check-types",
    "check:icons": "yarn workspace @repo/dfe-icons generate:check",
    "test": "turbo run test"
  },
  "devDependencies": {
    "prettier": "3.8.1",
    "turbo": "^2.9.14",
    "typescript": "5.9.2"
  },
  "resolutions": {
    "esbuild": "^0.28.1",
    "postcss": "^8.5.18",
    "js-yaml": "^4.3.1",
    "next-auth/uuid": "^11.1.1",
    "brace-expansion@npm:^1.1.7": "1.1.18",
    "brace-expansion@npm:^2.0.1": "2.1.4",
    "brace-expansion@npm:^5.0.2": "5.0.9",
    "nanoid@npm:^3.3.16": "3.3.18",
    "fast-uri@npm:^3.0.1": "3.1.5",
    "tar": "^7.5.21",
    "next/sharp": "^0.35.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "yarn@4.13.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
