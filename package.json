{
  "name": "dfe-ui",
  "private": true,
  "description": "Web console for the HyperI Data Fusion Engine. Talks only to the dfe-engine API, with HyperDX embedded for data exploration.",
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "audit": "node scripts/audit.mjs",
    "import-scope-drift": "node scripts/import-scope-drift.mjs",
    "build": "turbo run build",
    "start": "yarn workspace dfe-core-ui start",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{css,json,md,mjs,ts,tsx,yaml,yml}\"",
    "format:check": "prettier --check .",
    "check-types": "turbo run check-types",
    "check:icons": "yarn workspace @repo/dfe-icons generate:check",
    "test": "turbo run test"
  },
  "devDependencies": {
    "prettier": "3.8.1",
    "turbo": "^2.9.14",
    "typescript": "5.9.2"
  },
  "resolutions": {
    "image-size": "^2.0.4",
    "js-yaml": "^4.3.2",
    "svgo": "^3.3.5",
    "fast-uri@^3.0.1": "^3.1.7",
    "undici@^7.21.0": "^7.29.1",
    "undici@^8.4.1": "^8.10.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "yarn@4.13.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
